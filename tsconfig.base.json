{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@survive/protocol": ["packages/protocol/src/index.ts"],
      "@survive/protocol/*": ["packages/protocol/src/*"],
      "@survive/game-data": ["packages/game-data/src/index.ts"],
      "@survive/game-data/*": ["packages/game-data/src/*"],
      "@survive/world": ["packages/world/src/index.ts"],
      "@survive/world/*": ["packages/world/src/*"],
      "@survive/simulation": ["packages/simulation/src/index.ts"],
      "@survive/simulation/*": ["packages/simulation/src/*"],
      "@survive/persistence": ["packages/persistence/src/index.ts"],
      "@survive/persistence/*": ["packages/persistence/src/*"],
      "@survive/netcode": ["packages/netcode/src/index.ts"],
      "@survive/netcode/*": ["packages/netcode/src/*"],
      "@survive/test-utils": ["packages/test-utils/src/index.ts"],
      "@survive/test-utils/*": ["packages/test-utils/src/*"]
    }
  }
}
